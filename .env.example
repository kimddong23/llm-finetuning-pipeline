# API Keys
WANDB_API_KEY=your_wandb_api_key_here
HF_TOKEN=your_huggingface_token_here
OPENAI_API_KEY=your_openai_key_for_evaluation

# Model Settings
MODEL_PATH=./results/models/best_model
BASE_MODEL=LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct
MAX_SEQ_LENGTH=2048
BATCH_SIZE=4

# Training Settings
LEARNING_RATE=2e-4
LORA_RANK=16
LORA_ALPHA=16
NUM_EPOCHS=3
GRADIENT_ACCUMULATION_STEPS=2

# Inference Settings
MAX_WORKERS=4
TIMEOUT_SECONDS=30

# Paths
DATA_DIR=./data
RESULTS_DIR=./results
CACHE_DIR=./cache
